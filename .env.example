# Database Configuration
DATABASE_URL=

# Authentication Secrets
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Admin / Owner Contact
OWNER_EMAIL=
ADMIN_ORDER_EMAIL=

# Application URL (used for email links and redirects)
APP_URL=https://amfruits.shop

# Production Email Provider: Resend API (outbound HTTPS 443)
RESEND_API_KEY=

# Sender Identity (display name and verified domain address)
SMTP_FROM="AM Fruits <orders@amfruits.shop>"

# Optional SMTP Provider (Leave SMTP_HOST empty when using Resend API)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

